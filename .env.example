# ============================================================
# top10s.lol — environment template
# Copy to .env.local and fill in real values.
# ============================================================

# --- Phase 1 (REQUIRED for any dev work) ---------------------

# Neon Postgres (https://console.neon.tech → Project → Connection Details)
# DATABASE_URL: pooled, used by app runtime via @neondatabase/serverless (HTTP).
# DATABASE_DIRECT_URL: direct, used by drizzle-kit migrations (TCP via postgres-js).
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/top10s?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/top10s?sslmode=require

# Clerk (https://dashboard.clerk.com → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase 2+ (leave blank for Phase 1) ----------------------

# Clerk webhook (Phase 2 — user sync)
CLERK_WEBHOOK_SECRET=whsec_xxx

# Upstash Redis (Phase 3+ — rate limit, idempotency)
# https://console.upstash.com → Create Database → REST credentials
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx
# Set true to bypass Upstash entirely (no-op stub). Default: false.
UPSTASH_MOCK=true

# Razorpay (Phase 3+ — payments; Test Mode until KYC)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Set true to skip real Razorpay API + signature verify. Default: false.
RAZORPAY_MOCK=true

# Cloudflare R2 (Phase 2 — logo storage)
# Required when STORAGE_DRIVER=r2 (default).
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=top10s-logos
R2_PUBLIC_URL=https://cdn.top10s.lol

# Storage driver switch. r2 = cloud, local = writes to ./public/uploads/.
# Dev without R2 creds: set STORAGE_DRIVER=local.
STORAGE_DRIVER=local

# Resend (Phase 12 — transactional email)
# When RESEND_API_KEY is unset, emails write to ./.emails/ instead of sending.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@top10s.lol

# --- Admin + misc --------------------------------------------

# Comma-separated. Emails here get auto-promoted to admin on first sign-in.
ADMIN_EMAILS=admin@top10s.lol

# Vercel cron auth (required in prod for /api/admin/cron/*).
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-32-byte-random-string
